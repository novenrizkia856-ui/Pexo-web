# Copy to .env.local for local development. Both are read at build time.

# Deployed origin, used to write the absolute og:image URL. Omit locally.
VITE_SITE_URL=

# Reown (WalletConnect) project id, from https://dashboard.reown.com
# Public by design: it ships in the bundle, and is scoped by the project's
# Allowed domains list. Leave empty to hide the WalletConnect connector.
VITE_WALLETCONNECT_PROJECT_ID=
